__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/

# Test and coverage reports
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover

# Local configuration and secrets
.env
.env.*
!.env.example
*.secret
*.pem

# Logs and runtime files
logs/*
*.log
*.pid

# Jupyter and notebook temporary files
.ipynb_checkpoints/

# Generated model outputs and reports
outputs/*

# Frontend dependencies and build output
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.vite/
